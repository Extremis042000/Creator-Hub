# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is gitignored — it is never committed.
#
# From Neon's dashboard, you'll get a connection string like:
#   postgresql://neondb_owner:AbC123xyz@ep-cool-name-12345.region.aws.neon.tech/neondb?sslmode=require
#
# Map it into the three variables below like this:
#   postgresql://<USERNAME>:<PASSWORD>@<HOST>/<DBNAME>?sslmode=require
#              -> DATABASE_USERNAME=<USERNAME>
#              -> DATABASE_PASSWORD=<PASSWORD>
#              -> DATABASE_URL=jdbc:postgresql://<HOST>/<DBNAME>?sslmode=require
#
# (JDBC needs the "jdbc:" prefix and no embedded username/password —
# those go in the two separate variables instead.)

DATABASE_URL=jdbc:postgresql://REPLACE_ME.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=REPLACE_ME
DATABASE_PASSWORD=REPLACE_ME

# Required — the app will not start without this. Signs/verifies our
# OWN session JWTs (unrelated to Google's tokens). Generate a random
# one yourself, e.g. in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
# Rotating this invalidates every existing session (everyone signed
# in gets signed out) — that's expected, not a bug.
JWT_SECRET=REPLACE_ME

# Optional. Leave blank until you've created a Google OAuth Client ID
# in Google Cloud Console (Founder Action Checklist) — Google sign-in
# simply reports "not verified" until this is set; nothing else here
# depends on it.
GOOGLE_CLIENT_ID=

# Comma-separated allowlist of Google account emails allowed to use
# /api/v1/admin/** (Phase 17). Must be the email of a Google account
# that has actually signed in to this app at least once (an app_user
# row must exist). Leave blank = no one has admin access. Example:
#   ADMIN_EMAILS=you@gmail.com,cofounder@gmail.com
ADMIN_EMAILS=

# Required — the app will not start without this. Signs/verifies
# digital-product download links (Phase 19) — a separate secret from
# JWT_SECRET on purpose (different concern: a download link, not a
# session). Generate the same way as JWT_SECRET, e.g. in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
DOWNLOAD_SIGNING_SECRET=REPLACE_ME

# Optional. Where purchased product files actually live on disk —
# never served from a public/static path (see DownloadController).
# Defaults to a "secure-files" folder next to the backend if unset.
SECURE_FILES_DIR=

# Optional, defaults to true. Lets ANY signed-in user "buy" a digital
# product for $0 to prove the purchase→download flow works, since no
# real PaymentProvider exists yet (Phase 20). Set to false once a real
# provider is wired up, so this never coexists with real payments.
TEST_PURCHASES_ENABLED=

# PhonePe (Phase 20 payment provider — Standard Checkout v2). Leave
# blank until onboarding is complete — real checkout stays disabled
# (test-mode purchases above keep working) until ALL FIVE PhonePe vars
# below are set. From the PhonePe Business Dashboard once approved:
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=

# PhonePe's own client-version identifier (a plain integer as a
# string, e.g. "1"), issued alongside the client id/secret — not a
# version of our own code.
PHONEPE_CLIENT_VERSION=

# Optional, defaults to true (sandbox/preprod). Set to false only once
# ready to accept real money — this switches to PhonePe's production API.
PHONEPE_SANDBOX=

# Set together in the PhonePe Business Dashboard when configuring the
# webhook URL there (https://<your-backend>/api/v1/webhooks/payment) —
# PhonePe echoes these back (hashed) on every webhook call so we can
# verify it's really them. Both required — checkout stays disabled
# without them even if the client id/secret above are set, since a
# provider that can start a checkout but never verify its own webhook
# would strand every real payment in PENDING forever.
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# AI generation (Phase 26). Leave ANTHROPIC_API_KEY blank = AI stays
# fully off, tools keep using their existing template engines. From the
# Anthropic Console (console.anthropic.com) with billing enabled -- a
# business API key, not a personal Claude subscription login.
ANTHROPIC_API_KEY=

# Optional kill switch, defaults to true. Set false to turn AI off
# instantly without removing the key.
AI_GENERATION_ENABLED=

# Optional, defaults to claude-opus-5. A cheaper tier (e.g.
# claude-sonnet-5) is a cost decision for the founder to make.
ANTHROPIC_MODEL=

# Optional, defaults to low (low|medium|high|xhigh|max).
ANTHROPIC_EFFORT=

# Error tracking (Phase 24). Leave blank = Sentry stays fully inert,
# no events sent, no startup behavior change. From sentry.io once
# you've created a free project (Platform: Spring Boot).
SENTRY_DSN=

# Optional, defaults to "development". Set to "production" on Render
# so events are correctly labeled by environment in the Sentry dashboard.
SENTRY_ENVIRONMENT=

# Optional, defaults to 0.1 (10% of requests traced for performance
# monitoring). Lower this (or set to 0) if the free Sentry event quota
# gets tight.
SENTRY_TRACES_SAMPLE_RATE=
