NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Used for canonical URLs, sitemap.xml, and OG/Twitter meta — set to
# the real production domain once one is purchased (Founder Action
# Checklist). Falls back to a placeholder if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave unset until the founder creates a real GA4 property
# (Founder Action Checklist) — analytics code no-ops entirely without
# this, never sends events to a placeholder property.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Leave unset until the founder creates a Google OAuth Client ID in
# Google Cloud Console (Founder Action Checklist — must match the
# GOOGLE_CLIENT_ID set on the backend). The login page shows "not
# configured yet" without this; nothing else depends on it.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com

# Leave unset until the founder is approved for Google AdSense
# (Founder Action Checklist — do not apply until there's real content/
# traffic history). Every ad slot renders nothing without this, zero
# Core Web Vitals impact. Once set, ads still only actually render
# once the "display-ads" feature flag is also turned on in the admin
# panel — a second, independent switch so ads can be pulled instantly
# without a redeploy.
# NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-xxxxxxxxxxxxxxxx
